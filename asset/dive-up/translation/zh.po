msgctxt "text"
msgid "规则书中没有写明的情况，请与同桌讨论并达成共识后继续游戏；同一问题反复出现时，记录进下一版判例。"
msgstr "规则书中没有写明的情况，请与同桌讨论并达成共识后继续游戏；同一问题反复出现时，记录进下一版判例。"

msgctxt "text"
msgid "规则指引书"
msgstr "规则指引书"

msgctxt "text"
msgid "判例"
msgstr "判例"

msgctxt "text"
msgid "输入任意问题，获得规则解答或者指引"
msgstr "输入任意问题，获得规则解答或者指引"

msgctxt "fragment"
msgid "“阿诺”"
msgstr "“阿诺”"

msgctxt "fragment"
msgid "“斑点鸽”"
msgstr "“斑点鸽”"

msgctxt "fragment"
msgid "“乌鸦”"
msgstr "“乌鸦”"

msgctxt "fragment"
msgid "“约翰”"
msgstr "“约翰”"

msgctxt "fragment"
msgid "(1)~(2)：随机选择你前、后「调查顺位」的「调查员」，弃置任意(1)张对其布置的「个体机制」。"
msgstr "(1)~(2)：随机选择你前、后「调查顺位」的「调查员」，弃置任意(1)张对其布置的「个体机制」。"

msgctxt "fragment"
msgid "(3)~(4)：随机选择你前、后「调查顺位」的「指挥者」，弃置其(1)张手牌。"
msgstr "(3)~(4)：随机选择你前、后「调查顺位」的「指挥者」，弃置其(1)张手牌。"

msgctxt "fragment"
msgid "(5)~(6)：累积(1)点「运势」。"
msgstr "(5)~(6)：累积(1)点「运势」。"

msgctxt "fragment"
msgid "(N) = 场上清醒的「调查员」"
msgstr "(N) = 场上清醒的「调查员」"

msgctxt "fragment"
msgid "(N) = 累计的「深潜」点数"
msgstr "(N) = 累计的「深潜」点数"

msgctxt "fragment"
msgid "(N) = 你已损失的「SAN」+ (1)"
msgstr "(N) = 你已损失的「SAN」+ (1)"

msgctxt "fragment"
msgid "(N) = 你支付的费用"
msgstr "(N) = 你支付的费用"

msgctxt "fragment"
msgid "(N) = 清醒「调查员」数量"
msgstr "(N) = 清醒「调查员」数量"

msgctxt "fragment"
msgid "(N) = 掷出的骰子点数"
msgstr "(N) = 掷出的骰子点数"

msgctxt "fragment"
msgid "(N)由你指定"
msgstr "(N)由你指定"

msgctxt "fragment"
msgid "《调查 : 深入》支持2~6名玩家游玩。若是组队对战，同一队伍的各位「指挥者」会共享「情报区」的「情报」卡牌（使用或消耗），共享获得的信息（手牌或「情报」相关），但只能指挥自己的「调查员」、使用自己的手牌。"
msgstr "《调查 : 深入》支持2~6名玩家游玩。若是组队对战，同一队伍的各位「指挥者」会共享「情报区」的「情报」卡牌（使用或消耗），共享获得的信息（手牌或「情报」相关），但只能指挥自己的「调查员」、使用自己的手牌。"

msgctxt "fragment"
msgid "《调查深入》打开的游戏盒与配件"
msgstr "《调查深入》打开的游戏盒与配件"

msgctxt "fragment"
msgid "《调查深入》的卡面把名称、概念和行动分开标记。看到不同的括号与字形时，不要只按日常语义理解；它们对应的是不同的规则入口。"
msgstr "《调查深入》的卡面把名称、概念和行动分开标记。看到不同的括号与字形时，不要只按日常语义理解；它们对应的是不同的规则入口。"

msgctxt "fragment"
msgid "《调查深入》盒内的卡牌与骰子配件"
msgstr "《调查深入》盒内的卡牌与骰子配件"

msgctxt "fragment"
msgid "《调查深入》情报卡牌与禁忌真相示例"
msgstr "《调查深入》情报卡牌与禁忌真相示例"

msgctxt "fragment"
msgid "《调查深入》是一款支持 2—6 人游玩的非直接对战美式桌游。FreshLi4 新鲜李四游戏工作室。"
msgstr "《调查深入》是一款支持 2—6 人游玩的非直接对战美式桌游。FreshLi4 新鲜李四游戏工作室。"

msgctxt "fragment"
msgid "《调查深入》游戏配件与卡牌"
msgstr "《调查深入》游戏配件与卡牌"

msgctxt "fragment"
msgid "《调查深入》Wiki 资料组织"
msgstr "《调查深入》Wiki 资料组织"

msgctxt "fragment"
msgid "「0」| 深度学习：弃置(1)张手牌，从「策略弃牌区」选取(1)张卡牌，加入手牌，不能选择由你在当前「操作阶段」中打出的卡牌，你累计(1)点「过热」。"
msgstr "「0」| 深度学习：弃置(1)张手牌，从「策略弃牌区」选取(1)张卡牌，加入手牌，不能选择由你在当前「操作阶段」中打出的卡牌，你累计(1)点「过热」。"

msgctxt "fragment"
msgid "「0」| 神经网络：你在使用「策略」卡牌时，可以使其消耗 = (0)，你累计(1)点「过热」。"
msgstr "「0」| 神经网络：你在使用「策略」卡牌时，可以使其消耗 = (0)，你累计(1)点「过热」。"

msgctxt "fragment"
msgid "「0」| 数据预演：你使用「策略」卡牌时，可以不消耗「情报」卡牌，而是累积(N)点「过热」，(N) = 使用的「策略」卡牌的费用。"
msgstr "「0」| 数据预演：你使用「策略」卡牌时，可以不消耗「情报」卡牌，而是累积(N)点「过热」，(N) = 使用的「策略」卡牌的费用。"

msgctxt "fragment"
msgid "「1」| 过载：本「轮」游戏结束时，指定友方「调查员」消耗(N)点「SAN」, (N) =「过热」点数 ÷ (2)，向上取整；若你选择不指定，或没有可指定的「调查员」，你「陷入疯狂」。"
msgstr "「1」| 过载：本「轮」游戏结束时，指定友方「调查员」消耗(N)点「SAN」, (N) =「过热」点数 ÷ (2)，向上取整；若你选择不指定，或没有可指定的「调查员」，你「陷入疯狂」。"

msgctxt "fragment"
msgid "「1」| 回报：仅(1)次；你调查到【禁忌真相】时，不消耗「SAN」，将【禁忌真相】洗回剩余的「情报卡组」。若你的「SAN」变化，可以重新使用(1)次此技能。"
msgstr "「1」| 回报：仅(1)次；你调查到【禁忌真相】时，不消耗「SAN」，将【禁忌真相】洗回剩余的「情报卡组」。若你的「SAN」变化，可以重新使用(1)次此技能。"

msgctxt "fragment"
msgid "「1」| 举一反三：你的每个「操作阶段」使用的第(1)张「策略」卡牌消耗 = (0)；若你执行了调查，额外使你当前「操作阶段」的下一张「策略」卡牌消耗 = (0)。"
msgstr "「1」| 举一反三：你的每个「操作阶段」使用的第(1)张「策略」卡牌消耗 = (0)；若你执行了调查，额外使你当前「操作阶段」的下一张「策略」卡牌消耗 = (0)。"

msgctxt "fragment"
msgid "「1」| 傀儡：每「轮」游戏开始时；指定(1)位「调查员」对其布置「辅助」卡牌：【傀儡 · 催眠师】；本轮结束后回收该「辅助」卡牌。"
msgstr "「1」| 傀儡：每「轮」游戏开始时；指定(1)位「调查员」对其布置「辅助」卡牌：【傀儡 · 催眠师】；本轮结束后回收该「辅助」卡牌。"

msgctxt "fragment"
msgid "「1」| 蛮横：弃置(N)张手牌；选择对除你以外「调查员」布置的(1)张「个体机制」卡牌，纳入你的手牌；(N) = 该卡牌的消耗；你在当前「操作阶段」使用此卡牌时无消耗。无法选择无法被弃置的卡牌。"
msgstr "「1」| 蛮横：弃置(N)张手牌；选择对除你以外「调查员」布置的(1)张「个体机制」卡牌，纳入你的手牌；(N) = 该卡牌的消耗；你在当前「操作阶段」使用此卡牌时无消耗。无法选择无法被弃置的卡牌。"

msgctxt "fragment"
msgid "「1」| 任务导向：每「轮」开始时可用；指定(1)位「调查员」；若其调查到【禁忌真相】，你指定(1)位「调查员」，消耗(1)点「SAN」，你减少(1)点「任务负债」；不可连续指定同一队伍的「调查员」。"
msgstr "「1」| 任务导向：每「轮」开始时可用；指定(1)位「调查员」；若其调查到【禁忌真相】，你指定(1)位「调查员」，消耗(1)点「SAN」，你减少(1)点「任务负债」；不可连续指定同一队伍的「调查员」。"

msgctxt "fragment"
msgid "「1」| 虔诚：若你调查的「情报」卡牌数量 > (4)，你调查到【禁忌真相】时消耗的「SAN」- (1)。"
msgstr "「1」| 虔诚：若你调查的「情报」卡牌数量 > (4)，你调查到【禁忌真相】时消耗的「SAN」- (1)。"

msgctxt "fragment"
msgid "「1」| 食髓知味：弃置总计(12)张「情报」或「策略」卡牌，恢复(1)点「SAN」。"
msgstr "「1」| 食髓知味：弃置总计(12)张「情报」或「策略」卡牌，恢复(1)点「SAN」。"

msgctxt "fragment"
msgid "「1」| 数据验证：弃置任意数量的「情报」卡牌，减少(N)点「过热」，(N) = 被弃置卡牌的费用总和 。"
msgstr "「1」| 数据验证：弃置任意数量的「情报」卡牌，减少(N)点「过热」，(N) = 被弃置卡牌的费用总和 。"

msgctxt "fragment"
msgid "「1」| 梭哈：每个「赌」技能掷出奇数之前，可以无限使用。"
msgstr "「1」| 梭哈：每个「赌」技能掷出奇数之前，可以无限使用。"

msgctxt "fragment"
msgid "「1」| 行乞：除你以外的「调查员」开始「操作阶段」时；你可以请求其「指挥者」给你(1)张手牌，若其同意，则可以额外抽(2)张手牌。"
msgstr "「1」| 行乞：除你以外的「调查员」开始「操作阶段」时；你可以请求其「指挥者」给你(1)张手牌，若其同意，则可以额外抽(2)张手牌。"

msgctxt "fragment"
msgid "「1」| 演绎法：每当你消耗了(N)张「情报」卡牌，窥探(N)张「情报」卡牌。"
msgstr "「1」| 演绎法：每当你消耗了(N)张「情报」卡牌，窥探(N)张「情报」卡牌。"

msgctxt "fragment"
msgid "「1」| 鱼死网破：你进行调查时，若受到胁迫效果，每调查(1)张「情报」卡牌，弃置任意「指挥者」(1)张手牌。"
msgstr "「1」| 鱼死网破：你进行调查时，若受到胁迫效果，每调查(1)张「情报」卡牌，弃置任意「指挥者」(1)张手牌。"

msgctxt "fragment"
msgid "「1」| 致命窥探：你调查到【禁忌真相】也无需公示；其他「指挥者」可以质疑你已经调查到【禁忌真相】；若质疑成功：该「指挥者」抽取你(2)张手牌；若质疑失败：你从该「指挥者」抽取手牌和「情报」卡牌各(1)张；若无人质疑你，在「操作阶段」结束时，将【禁忌真相】洗回「情报卡组」。"
msgstr "「1」| 致命窥探：你调查到【禁忌真相】也无需公示；其他「指挥者」可以质疑你已经调查到【禁忌真相】；若质疑成功：该「指挥者」抽取你(2)张手牌；若质疑失败：你从该「指挥者」抽取手牌和「情报」卡牌各(1)张；若无人质疑你，在「操作阶段」结束时，将【禁忌真相】洗回「情报卡组」。"

msgctxt "fragment"
msgid "「2」| 博学多闻：若你在当前「操作阶段」使用过「情报」卡牌，在你结束「操作阶段」后，从「情报弃牌区」选取(1)张「情报」卡牌，加入你的手牌。"
msgstr "「2」| 博学多闻：若你在当前「操作阶段」使用过「情报」卡牌，在你结束「操作阶段」后，从「情报弃牌区」选取(1)张「情报」卡牌，加入你的手牌。"

msgctxt "fragment"
msgid "「2」| 抽丝剥茧：你的「操作阶段」开始时，窥探(N)张「情报」卡牌，(N) = (你当前拥有的「情报」卡牌和手牌数量绝对差值) ÷ 2，向上取整。"
msgstr "「2」| 抽丝剥茧：你的「操作阶段」开始时，窥探(N)张「情报」卡牌，(N) = (你当前拥有的「情报」卡牌和手牌数量绝对差值) ÷ 2，向上取整。"

msgctxt "fragment"
msgid "「2」| 赌！！：掷(1)个骰子，如为奇数，窥探(3)张「情报」卡牌并分别对其调整；如为偶数，你在当前「操作阶段」受到胁迫 + (3)。"
msgstr "「2」| 赌！！：掷(1)个骰子，如为奇数，窥探(3)张「情报」卡牌并分别对其调整；如为偶数，你在当前「操作阶段」受到胁迫 + (3)。"

msgctxt "fragment"
msgid "「2」| 极度苦痛：消耗(1)点「SAN」；从「策略卡组」抽(7)张「策略」卡牌，从「情报弃牌区」选取(7)张情报卡牌，加入手牌。"
msgstr "「2」| 极度苦痛：消耗(1)点「SAN」；从「策略卡组」抽(7)张「策略」卡牌，从「情报弃牌区」选取(7)张情报卡牌，加入手牌。"

msgctxt "fragment"
msgid "「2」| 勒索：弃置(2)张手牌；从任意(1)位「指挥者」的手牌抽(1)张牌，纳入你的手牌；你在当前「操作阶段」使用此卡牌时无消耗。"
msgstr "「2」| 勒索：弃置(2)张手牌；从任意(1)位「指挥者」的手牌抽(1)张牌，纳入你的手牌；你在当前「操作阶段」使用此卡牌时无消耗。"

msgctxt "fragment"
msgid "「2」| 祈祷：若你在当前「操作阶段」进行调查后消耗了「情报」卡牌，你可以额外执行(1)次调查；每次调查的「情报」卡牌数量需要大于上一次。"
msgstr "「2」| 祈祷：若你在当前「操作阶段」进行调查后消耗了「情报」卡牌，你可以额外执行(1)次调查；每次调查的「情报」卡牌数量需要大于上一次。"

msgctxt "fragment"
msgid "「2」| 全身而退：立即结束你的「操作阶段」，你不进行本「轮」后续操作，累计(1)点「任务负债」；若你累计(3)点「任务负债」，你在「操作阶段」结束后「陷入疯狂」。"
msgstr "「2」| 全身而退：立即结束你的「操作阶段」，你不进行本「轮」后续操作，累计(1)点「任务负债」；若你累计(3)点「任务负债」，你在「操作阶段」结束后「陷入疯狂」。"

msgctxt "fragment"
msgid "「2」| 神秘适应：你调查到【禁忌真相】时，最多只会消耗(1)点「SAN」。"
msgstr "「2」| 神秘适应：你调查到【禁忌真相】时，最多只会消耗(1)点「SAN」。"

msgctxt "fragment"
msgid "「2」| 失控：你使用「策略」卡牌时，从「策略卡组」顶部翻出(1)张卡牌，也对该「调查员」使用。"
msgstr "「2」| 失控：你使用「策略」卡牌时，从「策略卡组」顶部翻出(1)张卡牌，也对该「调查员」使用。"

msgctxt "fragment"
msgid "「2」| 拾荒：其他「调查员」弃置手牌时，你可以将其中的一半 (向下取整，不小于1) 加入手牌。"
msgstr "「2」| 拾荒：其他「调查员」弃置手牌时，你可以将其中的一半 (向下取整，不小于1) 加入手牌。"

msgctxt "fragment"
msgid "「2」| 势大力沉：当有【胁迫】被布置时，你可以弃置(N) + (1)张手牌，将该【胁迫】布置给任意(1)位「调查员」；(N) = 使用该【胁迫】时支付的费用。"
msgstr "「2」| 势大力沉：当有【胁迫】被布置时，你可以弃置(N) + (1)张手牌，将该【胁迫】布置给任意(1)位「调查员」；(N) = 使用该【胁迫】时支付的费用。"

msgctxt "fragment"
msgid "「2」| 袖手旁观：仅(1)次；你调查到【禁忌真相】时，可弃置所有手牌和「情报区」的「情报」卡牌，然后将【禁忌真相】洗回剩余的「情报卡组」。若你的「SAN」发生变化，可以重新使用(1)次此技能。"
msgstr "「2」| 袖手旁观：仅(1)次；你调查到【禁忌真相】时，可弃置所有手牌和「情报区」的「情报」卡牌，然后将【禁忌真相】洗回剩余的「情报卡组」。若你的「SAN」发生变化，可以重新使用(1)次此技能。"

msgctxt "fragment"
msgid "「2」| 选召：每「轮」游戏开始时，指定其他队伍的(1)位「调查员」；若其接受【选召】，你们对彼此使用「策略」卡牌时没有消耗；你可以消耗(1)点「SAN」，使其强制接受【选召】，即使这会使你「陷入疯狂」。"
msgstr "「2」| 选召：每「轮」游戏开始时，指定其他队伍的(1)位「调查员」；若其接受【选召】，你们对彼此使用「策略」卡牌时没有消耗；你可以消耗(1)点「SAN」，使其强制接受【选召】，即使这会使你「陷入疯狂」。"

msgctxt "fragment"
msgid "「2」| 掩饰：弃置(N)张手牌；交换你和(1)位「调查员」的全部「个体机制」；(N) = 你和其「调查顺位」的差值。"
msgstr "「2」| 掩饰：弃置(N)张手牌；交换你和(1)位「调查员」的全部「个体机制」；(N) = 你和其「调查顺位」的差值。"

msgctxt "fragment"
msgid "「2」| 诱导：每个「操作阶段」一次；弃置(3)张手牌；指定(1)位「调查员」；对其布置「辅助」卡牌：【盲从 · 催眠师】。若你与其「指挥者」手牌数量相同，则视作你已经弃置了(2)张手牌。"
msgstr "「2」| 诱导：每个「操作阶段」一次；弃置(3)张手牌；指定(1)位「调查员」；对其布置「辅助」卡牌：【盲从 · 催眠师】。若你与其「指挥者」手牌数量相同，则视作你已经弃置了(2)张手牌。"

msgctxt "fragment"
msgid "「2」| 专注：你不会因为【禁忌真相】以外的原因被动消耗「SAN」，也不能主动消耗「SAN」。"
msgstr "「2」| 专注：你不会因为【禁忌真相】以外的原因被动消耗「SAN」，也不能主动消耗「SAN」。"

msgctxt "fragment"
msgid "「3」| 刁难：每个「操作阶段」一次，当你使用「策略」卡牌，你可以弃置任意(1)位「指挥者」的(1)张手牌。"
msgstr "「3」| 刁难：每个「操作阶段」一次，当你使用「策略」卡牌，你可以弃置任意(1)位「指挥者」的(1)张手牌。"

msgctxt "fragment"
msgid "「3」| 恫吓：每个「操作阶段」一次；弃置(N)张手牌；指定(1)位「调查员」；对其布置「辅助」卡牌：【胁迫 · 催眠师】。若你与其「指挥者」手牌数量相同，则视作你已经弃置了(2)张手牌。"
msgstr "「3」| 恫吓：每个「操作阶段」一次；弃置(N)张手牌；指定(1)位「调查员」；对其布置「辅助」卡牌：【胁迫 · 催眠师】。若你与其「指挥者」手牌数量相同，则视作你已经弃置了(2)张手牌。"

msgctxt "fragment"
msgid "「3」| 赌！：掷(1)个骰子，如为奇数，窥探(3)张「情报」卡牌；如为偶数，弃置(2)张「情报区」的「情报」。"
msgstr "「3」| 赌！：掷(1)个骰子，如为奇数，窥探(3)张「情报」卡牌；如为偶数，弃置(2)张「情报区」的「情报」。"

msgctxt "fragment"
msgid "「3」| 负罪：你的友方「调查员」需要消耗「SAN」时，你可以代替其消耗「SAN」。"
msgstr "「3」| 负罪：你的友方「调查员」需要消耗「SAN」时，你可以代替其消耗「SAN」。"

msgctxt "fragment"
msgid "「3」| 过热降频：当你在当前「操作阶段」首次累计到(3)点「过热」或没有执行过操作时可用；调查(3)张「情报」卡牌，减少(1)点「过热」，立即结束当前的「操作阶段」。"
msgstr "「3」| 过热降频：当你在当前「操作阶段」首次累计到(3)点「过热」或没有执行过操作时可用；调查(3)张「情报」卡牌，减少(1)点「过热」，立即结束当前的「操作阶段」。"

msgctxt "fragment"
msgid "「3」| 见微知著：使用【窥探】时额外窥探的(1)张「情报」。"
msgstr "「3」| 见微知著：使用【窥探】时额外窥探的(1)张「情报」。"

msgctxt "fragment"
msgid "「3」| 九条命：当你要消耗「SAN」，你可以消耗(3)点运势，使你消耗的「SAN」- (1)。该技能只能使用最多(9)次。"
msgstr "「3」| 九条命：当你要消耗「SAN」，你可以消耗(3)点运势，使你消耗的「SAN」- (1)。该技能只能使用最多(9)次。"

msgctxt "fragment"
msgid "「3」| 巨人肩膀：你进行调查时，从「策略卡组」抽(1)张「策略」卡牌。"
msgstr "「3」| 巨人肩膀：你进行调查时，从「策略卡组」抽(1)张「策略」卡牌。"

msgctxt "fragment"
msgid "「3」| 力大砖飞：你可以使用多张「情报」卡牌支付【胁迫】的费用。"
msgstr "「3」| 力大砖飞：你可以使用多张「情报」卡牌支付【胁迫】的费用。"

msgctxt "fragment"
msgid "「3」| 明哲保身：你调查到【禁忌真相】时，可以选择(1)位有足够「SAN」的友方「调查员」，由其代为消耗「SAN」。"
msgstr "「3」| 明哲保身：你调查到【禁忌真相】时，可以选择(1)位有足够「SAN」的友方「调查员」，由其代为消耗「SAN」。"

msgctxt "fragment"
msgid "「3」| 深度苦痛：消耗(1)点「SAN」；从「策略卡组」抽(5)张「策略」卡牌，从「情报弃牌区」选取(5)张情报卡牌，加入手牌。"
msgstr "「3」| 深度苦痛：消耗(1)点「SAN」；从「策略卡组」抽(5)张「策略」卡牌，从「情报弃牌区」选取(5)张情报卡牌，加入手牌。"

msgctxt "fragment"
msgid "「3」| 四海为家：弃置(2)张手牌；你在当前的「操作阶段」无需且不能调查。你最多可以使用(N)次此技能，(N) = 本局游戏参与的「调查员」数量。"
msgstr "「3」| 四海为家：弃置(2)张手牌；你在当前的「操作阶段」无需且不能调查。你最多可以使用(N)次此技能，(N) = 本局游戏参与的「调查员」数量。"

msgctxt "fragment"
msgid "「3」| 随心所欲：每个「操作阶段」使用(N)次，掷(1)个骰子，(N) = 你已经损失的「SAN」+ (1)。根据骰出的点数，使用以下技能："
msgstr "「3」| 随心所欲：每个「操作阶段」使用(N)次，掷(1)个骰子，(N) = 你已经损失的「SAN」+ (1)。根据骰出的点数，使用以下技能："

msgctxt "fragment"
msgid "「3」| 虚张声势：你可以盖置打出「情报」卡牌，以支付「策略」卡牌的费用。其他「指挥者」可以质疑你打出的费用不足。若费用足够：收回该「情报」卡牌，「策略」卡牌视作成功打出；若费用不足：弃置该「情报」卡牌，「策略」卡牌收回手牌，你在当前「操作阶段」无法再次使用此技能。"
msgstr "「3」| 虚张声势：你可以盖置打出「情报」卡牌，以支付「策略」卡牌的费用。其他「指挥者」可以质疑你打出的费用不足。若费用足够：收回该「情报」卡牌，「策略」卡牌视作成功打出；若费用不足：弃置该「情报」卡牌，「策略」卡牌收回手牌，你在当前「操作阶段」无法再次使用此技能。"

msgctxt "fragment"
msgid "「3」| 有备无患：你的「操作阶段」结束时，选择(1)位「指挥者」，将手牌抽取到与对方一致。"
msgstr "「3」| 有备无患：你的「操作阶段」结束时，选择(1)位「指挥者」，将手牌抽取到与对方一致。"

msgctxt "fragment"
msgid "「4」| 超载：你的「操作阶段」结束时，指定(1)位友方「调查员」，消耗(1)点「SAN」；若你选择不指定，或没有可指定的「调查员」，你「陷入疯狂」。"
msgstr "「4」| 超载：你的「操作阶段」结束时，指定(1)位友方「调查员」，消耗(1)点「SAN」；若你选择不指定，或没有可指定的「调查员」，你「陷入疯狂」。"

msgctxt "fragment"
msgid "「4」| 苦痛： 消耗(1)点「SAN」；从「策略卡组」抽(3)张「策略」卡牌，从「情报弃牌区」选取(3)张情报卡牌，加入手牌。"
msgstr "「4」| 苦痛： 消耗(1)点「SAN」；从「策略卡组」抽(3)张「策略」卡牌，从「情报弃牌区」选取(3)张情报卡牌，加入手牌。"

msgctxt "fragment"
msgid "「4」| 逃避：弃置(N)张手牌；交换你和(1)位「调查员」的「调查顺位」；(N) = 你和其「调查顺位」的差值。"
msgstr "「4」| 逃避：弃置(N)张手牌；交换你和(1)位「调查员」的「调查顺位」；(N) = 你和其「调查顺位」的差值。"

msgctxt "fragment"
msgid "「4」| 祖传手艺：你可以自由选择从「情报卡组」的最上或最下，进行正向或反向调查。"
msgstr "「4」| 祖传手艺：你可以自由选择从「情报卡组」的最上或最下，进行正向或反向调查。"

msgctxt "fragment"
msgid "「操作阶段」分为三个步骤："
msgstr "「操作阶段」分为三个步骤："

msgctxt "fragment"
msgid "「操作阶段」结束后累计(1)点「深潜」"
msgstr "「操作阶段」结束后累计(1)点「深潜」"

msgctxt "fragment"
msgid "「操作阶段」结束时"
msgstr "「操作阶段」结束时"

msgctxt "fragment"
msgid "「操作阶段」开始、进入与结束时，依照规则执行对应操作"
msgstr "「操作阶段」开始、进入与结束时，依照规则执行对应操作"

msgctxt "fragment"
msgid "「操作阶段」开始后必须首先进行调查。如果「调查员」因【跳过】或其他效果无需调查，盲从视为未生效。"
msgstr "「操作阶段」开始后必须首先进行调查。如果「调查员」因【跳过】或其他效果无需调查，盲从视为未生效。"

msgctxt "fragment"
msgid "「操作阶段」开始时，「调查员」可以窥探(N)张「情报」卡牌。(N) =「调查员」已损失的「SAN」。"
msgstr "「操作阶段」开始时，「调查员」可以窥探(N)张「情报」卡牌。(N) =「调查员」已损失的「SAN」。"

msgctxt "fragment"
msgid "「策略卡组」的底部"
msgstr "「策略卡组」的底部"

msgctxt "fragment"
msgid "「调查」是从「情报卡组」顶部顺序翻看并公示 (1)—(3) 张「情报」卡牌，然后纳入自己的「情报区」。"
msgstr "「调查」是从「情报卡组」顶部顺序翻看并公示 (1)—(3) 张「情报」卡牌，然后纳入自己的「情报区」。"

msgctxt "fragment"
msgid "「调查顺位」"
msgstr "「调查顺位」"

msgctxt "fragment"
msgid "「调查员」，消耗(1)点「SAN」"
msgstr "「调查员」，消耗(1)点「SAN」"

msgctxt "fragment"
msgid "「调查员」不公示其调查到的「情报」卡牌（包括【禁忌真相】），「情报区」的「情报」卡牌面朝下盖置。"
msgstr "「调查员」不公示其调查到的「情报」卡牌（包括【禁忌真相】），「情报区」的「情报」卡牌面朝下盖置。"

msgctxt "fragment"
msgid "「调查员」的「操作阶段」开始后，必须首先进行调查。若调查员因【跳过】或【异时癖】等效果无需调查，盲从视为未生效。"
msgstr "「调查员」的「操作阶段」开始后，必须首先进行调查。若调查员因【跳过】或【异时癖】等效果无需调查，盲从视为未生效。"

msgctxt "fragment"
msgid "「调查员」的「指挥者」需要将手牌弃置到 ≤ (8)张。"
msgstr "「调查员」的「指挥者」需要将手牌弃置到 ≤ (8)张。"

msgctxt "fragment"
msgid "「调查员」的「SAN」 分散到"
msgstr "「调查员」的「SAN」 分散到"

msgctxt "fragment"
msgid "「调查员」的「SAN」 集中于"
msgstr "「调查员」的「SAN」 集中于"

msgctxt "fragment"
msgid "「调查员」调查到【禁忌真相】会损失「SAN」，「SAN」消耗完的「调查员」会「陷入疯狂」。"
msgstr "「调查员」调查到【禁忌真相】会损失「SAN」，「SAN」消耗完的「调查员」会「陷入疯狂」。"

msgctxt "fragment"
msgid "「调查员」调查到【禁忌真相】会损失「SAN」；「SAN」消耗完的「调查员」会「陷入疯狂」。自己的队伍需要规避真相，同时诱导其他队伍更早触及它。"
msgstr "「调查员」调查到【禁忌真相】会损失「SAN」；「SAN」消耗完的「调查员」会「陷入疯狂」。自己的队伍需要规避真相，同时诱导其他队伍更早触及它。"

msgctxt "fragment"
msgid "「调查员」调查到【禁忌真相】时"
msgstr "「调查员」调查到【禁忌真相】时"

msgctxt "fragment"
msgid "「调查员」调查到【禁忌真相】时，你可以选择使其额外消耗(1)点「SAN」。之后，你立即指定另一队伍的(1)位「调查员」，使其消耗(1)点「SAN」。"
msgstr "「调查员」调查到【禁忌真相】时，你可以选择使其额外消耗(1)点「SAN」。之后，你立即指定另一队伍的(1)位「调查员」，使其消耗(1)点「SAN」。"

msgctxt "fragment"
msgid "「调查员」会因此「恢复清醒」"
msgstr "「调查员」会因此「恢复清醒」"

msgctxt "fragment"
msgid "「调查员」会因此「陷入疯狂」"
msgstr "「调查员」会因此「陷入疯狂」"

msgctxt "fragment"
msgid "「调查员」结束「操作阶段」时"
msgstr "「调查员」结束「操作阶段」时"

msgctxt "fragment"
msgid "「调查员」可以清空自己的「深潜」点数"
msgstr "「调查员」可以清空自己的「深潜」点数"

msgctxt "fragment"
msgid "「调查员」可以选择消耗哪个「SAN」"
msgstr "「调查员」可以选择消耗哪个「SAN」"

msgctxt "fragment"
msgid "「调查员」每消耗(2)点费用"
msgstr "「调查员」每消耗(2)点费用"

msgctxt "fragment"
msgid "「调查员」若没有以「调查范围」上限的数量进行调查，则调查到【禁忌真相】时，消耗的「SAN」+ (1)。"
msgstr "「调查员」若没有以「调查范围」上限的数量进行调查，则调查到【禁忌真相】时，消耗的「SAN」+ (1)。"

msgctxt "fragment"
msgid "「调查员」依照「调查顺位」轮流进行「操作阶段」"
msgstr "「调查员」依照「调查顺位」轮流进行「操作阶段」"

msgctxt "fragment"
msgid "「调查员」在当前「操作阶段」可以(0)费用"
msgstr "「调查员」在当前「操作阶段」可以(0)费用"

msgctxt "fragment"
msgid "「概念词汇」"
msgstr "「概念词汇」"

msgctxt "fragment"
msgid "「概念词汇」表示《调查深入》的专用概念，例如「SAN」「情报区」和「陷入疯狂」。"
msgstr "「概念词汇」表示《调查深入》的专用概念，例如「SAN」「情报区」和「陷入疯狂」。"

msgctxt "fragment"
msgid "「个体机制」"
msgstr "「个体机制」"

msgctxt "fragment"
msgid "「公共手牌区」的卡牌"
msgstr "「公共手牌区」的卡牌"

