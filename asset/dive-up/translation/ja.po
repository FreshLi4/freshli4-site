msgctxt "fragment"
msgid "获得(1)点临时「SAN」(加一个骰子)"
msgstr "一時的な「SAN」ポイントを (1) 獲得 (プラス 1 つのダイス)"

msgctxt "fragment"
msgid "机器学习 · 仿生人"
msgstr "機械学習 · バイオニックマン"

msgctxt "fragment"
msgid "机制、调查员、环境与印刷勘误的快速查找页。"
msgstr "力学、研究者、環境、印刷の正誤表のクイック検索ページ。"

