msgid "先给每一叠牌找到位置。"
msgstr "First find a place for each pile of cards."

msgctxt "fragment"
msgid "先认出四类卡组，再开始布置。"
msgstr "Recognize the four types of decks first, and then start arranging them."

msgctxt "fragment"
msgid "先识别文字的身份。"
msgstr "First identify the identity of the text."

msgctxt "fragment"
msgid "显示全部 张卡牌"
msgstr "Show all cards"

msgctxt "fragment"
msgid "显示全部章节"
msgstr "Show all chapters"

msgctxt "fragment"
msgid "献祭 · I"
msgstr "Sacrifice · I"

msgctxt "fragment"
msgid "献祭 · II"
msgstr "Sacrifice · II"

msgctxt "fragment"
msgid "向调查助手提问"
msgstr "Ask a question to an investigative assistant"

msgctxt "fragment"
msgid "消耗(1)点「SAN」"
msgstr "Consume (1) \"SAN\" point"

msgctxt "fragment"
msgid "消耗的「情报」卡牌不弃置"
msgstr "Consumed \"Intelligence\" cards are not discarded"

msgctxt "fragment"
msgid "消耗的「SAN」+ (1)"
msgstr "\"SAN\" consumed + (1)"

msgctxt "fragment"
msgid "消耗的「SAN」翻倍"
msgstr "The \"SAN\" consumed is doubled"

msgctxt "fragment"
msgid "胁迫"
msgstr "Coercion"

