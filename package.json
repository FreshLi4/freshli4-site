{
  "name": "freshli4-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "generate:wiki": "node build/generate-investigation-wiki.mjs",
    "predev": "npm run generate:wiki",
    "dev": "vite",
    "prebuild": "npm run generate:wiki",
    "build": "vite build",
    "postbuild": "pagefind --site dist --output-path dist/pagefind",
    "preview": "vite preview",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/investigation-pages.test.mjs tests/wiki-content.test.mjs tests/search-and-ai-format.test.mjs",
    "pretypecheck": "npm run generate:wiki",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "pagefind": "^1.5.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
