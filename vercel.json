{
  "headers": [
    { "source": "/pitch-deck", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/pitch-deck/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] }
  ],
  "functions": {
    "api/rules-ai.ts": {
      "maxDuration": 60,
      "includeFiles": "{asset/dive-up/wiki/**/*.md,asset/dive-up/wiki/**/*.csv,asset/dive-up/translation/*.po,src/generated/*.ts}"
    }
  },
  "rewrites": [
    { "source": "/ball-maze", "destination": "/" },
    { "source": "/ball-maze/", "destination": "/" },
    { "source": "/ball-maze/:path*", "destination": "/" },
    { "source": "/investigation-delve-boardgame", "destination": "/" },
    { "source": "/investigation-delve-boardgame/", "destination": "/" },
    { "source": "/investigation-delve-boardgame/:path*", "destination": "/" },
    { "source": "/games/investigation-delve/rules", "destination": "/" },
    { "source": "/games/investigation-delve/rules/", "destination": "/" },
    { "source": "/games/investigation-delve/rules/:path*", "destination": "/" }
  ]
}
